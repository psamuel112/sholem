{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "About Us"
    },
    "subtitle": {
      "type": "text"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "storyTitle": {
      "type": "string",
      "default": "Our Story"
    },
    "story": {
      "type": "richtext"
    },
    "visionTitle": {
      "type": "string",
      "default": "Our Vision"
    },
    "vision": {
      "type": "text"
    },
    "missionTitle": {
      "type": "string",
      "default": "Our Mission"
    },
    "mission": {
      "type": "text"
    },
    "valuesTitle": {
      "type": "string",
      "default": "Our Core Values"
    },
    "values": {
      "type": "component",
      "repeatable": true,
      "component": "shared.value-item"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "founderName": {
      "type": "string"
    },
    "founderRole": {
      "type": "string"
    },
    "founderBio": {
      "type": "text"
    },
    "founderImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
